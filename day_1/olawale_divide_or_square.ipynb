    "import math\n",
    "from typing import Union\n",
    "def divide_or_square(number: int | float)-> int | float: \n",
    "    \n",
    "    if number % 5 == 0:\n",
    "        return round(math.sqrt(number), 2)\n",
    "    else:\n",
    "        return number % 5"
